# Copia este archivo como .env (ignorado por git). Todos los valores tienen un valor por defecto en
# docker-compose.yml, así que .env solo hace falta para cambiar recursos o apuntar a Neon.

# --- Recursos de Spark -----------------------------------------------------------------------------------
# Presupuesto por defecto: 2 workers x (5 núcleos, 3 GB) + driver de 2 GB + HDFS ~1 GB.
SPARK_WORKER_REPLICAS=2
SPARK_WORKER_CORES=5
SPARK_WORKER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=2500m
SPARK_DRIVER_MEMORY=2g

# --- Puertos publicados en 127.0.0.1 ---------------------------------------------------------------------
# Cámbialos si alguno ya está ocupado en tu máquina.
HDFS_UI_PORT=9870
SPARK_MASTER_UI_PORT=18080
SPARK_DRIVER_UI_PORT=4040
SERVING_DB_PORT=5440

# --- Base de datos de serving local (réplica del esquema de Neon) ---------------------------------------
SERVING_DB_PASSWORD=airbnb_local
# Contraseña del rol de solo lectura que usa el dashboard.
DASHBOARD_DB_PASSWORD=dashboard_local

# --- Publicación en Neon (opcional) ----------------------------------------------------------------------
# Se pasan en la línea de órdenes al publicar en producción; ver README, sección "Publicar en Neon".
# SERVING_DATABASE_URL=postgresql://<rol propietario>:<contraseña>@<host directo de Neon>/<base>?sslmode=require
# DASHBOARD_REVALIDATE_URL=https://bigdata-airbnb.vfernandezg.dev/api/revalidate
# DASHBOARD_REVALIDATE_SECRET=
