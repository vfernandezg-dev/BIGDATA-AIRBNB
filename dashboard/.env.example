# Copia este archivo como .env.local (ignorado por git).

# Conexión de SOLO LECTURA a los marts. En local apunta a la base `serving-db` del stack de Docker;
# en Vercel la define Terraform con el host con pooler de Neon.
DATABASE_URL=postgresql://dashboard_ro:dashboard_local@127.0.0.1:5440/airbnb

# Secreto que debe enviar el pipeline al publicar datos para invalidar la caché (POST /api/revalidate).
REVALIDATE_SECRET=cambia-este-valor-en-local

# URL pública del sitio, para los metadatos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
